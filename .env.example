# =============================================================================
# 4chan /twg/ & /utwg/ Daily Digest Bot Configuration
# =============================================================================

# Часовой пояс (по умолчанию: Europe/Moscow)
TIMEZONE=Europe/Moscow

# Выбор AI-провайдера: 'grok' (xAI), 'groq' (Groq Cloud), 'gemini' (Google)
AI_PROVIDER=grok

# =============================================================================
# 1. xAI Grok API (https://console.x.ai/)
# =============================================================================
GROK_API_KEY=xai-your-api-key-here
GROK_MODEL=grok-beta

# =============================================================================
# 2. Groq Cloud (Альтернатива: https://console.groq.com - бесплатно)
# =============================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# 3. Google Gemini (Альтернатива: https://aistudio.google.com - бесплатно)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# 4. DeepL API (https://www.deepl.com/pro-api - 500k символов/мес бесплатно)
# =============================================================================
# Включить перевод через DeepL (true / false)
# Если true: ИИ генерирует выжимку на английском, а DeepL переводит ее на русский.
USE_DEEPL=true
DEEPL_API_KEY=your-deepl-auth-key-here
# Укажите true, если у вас платный DeepL Pro (для бесплатного ключа с :fx оставьте false)
DEEPL_IS_PRO=false

# =============================================================================
# 5. Telegram Bot & Канал
# =============================================================================
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# ID канала или username (@channel_name или -1001234567890)
# Внимание: бот должен быть добавлен в администраторы канала с правом публикации!
TELEGRAM_CHAT_ID=@your_channel_name
# Беззвучные сообщения в канал (true / false)
TELEGRAM_DISABLE_NOTIFICATION=false

# =============================================================================
# 6. Email Alerts через Brevo (https://app.brevo.com/)
# =============================================================================
# Получить SMTP ключ в Brevo: Settings -> Senders, Domains & Dedicated IPs -> SMTP
# Порт: 587
# DSN формат: smtp://<EMAIL_ЛОГИН_BREVO>:<SMTP_KEY>@smtp-relay.brevo.com:587
ALERT_EMAIL_TO=your_alert_recipient@example.com
ALERT_EMAIL_FROM=alerts@your-verified-domain-or-brevo.com
SMTP_DSN=smtp://your_brevo_account@example.com:xsmtpsib-your_brevo_master_key@smtp-relay.brevo.com:587
